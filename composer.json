{
    "name": "dkvadratu/filament-seo-extended",
    "description": "Extended Filament SEO fields and JSON-LD for Ralph J. Smit's Laravel SEO.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "ralphjsmit/laravel-seo": "^1.8"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": { "psr-4": { "Dkvadratu\\FilamentSeoExtended\\": "src/" } },
    "autoload-dev": { "psr-4": { "Dkvadratu\\FilamentSeoExtended\\Tests\\": "tests/" } },
    "extra": { "laravel": { "providers": ["Dkvadratu\\FilamentSeoExtended\\SeoExtendedServiceProvider"] } },
    "scripts": { "test": "phpunit" }
}
